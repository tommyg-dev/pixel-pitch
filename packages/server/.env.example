# Solana RPC endpoint (use a paid endpoint in production to avoid rate limits)
SOLANA_RPC_URL=https://api.devnet.solana.com

# SPL mint of your pump.fun token. Leave blank to DISABLE token gating (dev).
TOKEN_MINT=

# Minimum UI token balance required to enter matchmaking.
TOKEN_MIN_HOLD=1

# Server port
PORT=2567
