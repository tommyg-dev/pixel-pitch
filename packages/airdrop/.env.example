# RPC + network
SOLANA_RPC_URL=https://api.devnet.solana.com

# SPL mint to distribute
TOKEN_MINT=

# Path to the funded payer/treasury keypair JSON (array of bytes from solana-keygen)
PAYER_KEYPAIR=./keypair.json

# Where to read recent winners from (the game server)
SERVER_HTTP=http://localhost:2567

# Reward sizing
WINDOW_MINUTES=60
TOKENS_PER_WIN=100
TOKEN_DECIMALS=6
