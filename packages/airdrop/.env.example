# RPC + network
SOLANA_RPC_URL=https://api.devnet.solana.com

# SPL mint to distribute
TOKEN_MINT=

# Treasury (payer) key — ONE of these:
#  - PAYER_SECRET: the base58 private key exported from Phantom/Solflare (easiest)
#  - PAYER_KEYPAIR: path to a keypair file (JSON byte array, or base58 in a file)
PAYER_SECRET=
PAYER_KEYPAIR=./keypair.json

# Where to read recent winners from (the game server)
SERVER_HTTP=http://localhost:2567

# Reward sizing
# Cycle length — top players from the last N minutes get paid (run on this cadence)
WINDOW_MINUTES=20
# Each cycle, this % of the treasury's $KFi balance is split among the top players
AIRDROP_PCT=10
# How many top players split the pool
TOP_N=5
# Ranked split of the pool: 1st, 2nd, then 3rd/4th/5th split the rest evenly.
# (Auto-normalised if fewer players show up.)
RANK_WEIGHTS=40,25,11.67,11.67,11.66
